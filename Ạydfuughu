local function createTab(tabName, iconAsset, layoutOrder)
    local TabBtn = Instance.new("TextButton")
    TabBtn.Parent = Sidebar
    TabBtn.BackgroundTransparency = 1
    TabBtn.Size = UDim2.new(0, 75, 0, 48)
    TabBtn.Text = ""
    TabBtn.LayoutOrder = layoutOrder

    local Icon = Instance.new("ImageLabel")
    Icon.Parent = TabBtn
    Icon.BackgroundTransparency = 1
    Icon.Position = UDim2.new(0.5, -10, 0, 4)
    Icon.Size = UDim2.new(0, 20, 0, 20)
    Icon.Image = iconAsset or "rbxassetid://6031280882"
    Icon.ImageColor3 = Color3.fromRGB(120, 135, 155)

    local TextLbl = Instance.new("TextLabel")
    TextLbl.Parent = TabBtn
    TextLbl.BackgroundTransparency = 1
    TextLbl.Position = UDim2.new(0, 0, 0, 26)
    TextLbl.Size = UDim2.new(1, 0, 0, 18)
    TextLbl.Font = Enum.Font.SourceSansSemibold
    TextLbl.Text = tabName
    TextLbl.TextColor3 = Color3.fromRGB(120, 135, 155)
    TextLbl.TextSize = 11

    local Page = Instance.new("ScrollingFrame")
    Page.Parent = ContentArea
    Page.BackgroundTransparency = 1
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.Visible = false
    Page.ScrollBarThickness = 3
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)

    local PageList = Instance.new("UIListLayout")
    PageList.Parent = Page
    PageList.SortOrder = Enum.SortOrder.LayoutOrder
    PageList.Padding = UDim.new(0, 8)

    PageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        Page.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 10)
    end)

    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Page.Visible = false
            t.Icon.ImageColor3 = Color3.fromRGB(120, 135, 155)
            t.Text.TextColor3 = Color3.fromRGB(120, 135, 155)
        end
        Page.Visible = true
        Icon.ImageColor3 = Color3.fromRGB(0, 160, 255)
        TextLbl.TextColor3 = Color3.fromRGB(0, 160, 255)
        HeaderTitle.Text = tabName:upper()
    end)

    local data = {Btn = TabBtn, Page = Page, Icon = Icon, Text = TextLbl}
    table.insert(tabs, data)

    if #tabs == 1 then
        Page.Visible = true
        Icon.ImageColor3 = Color3.fromRGB(0, 160, 255)
        TextLbl.TextColor3 = Color3.fromRGB(0, 160, 255)
        HeaderTitle.Text = tabName:upper()
    end

    return Page
end


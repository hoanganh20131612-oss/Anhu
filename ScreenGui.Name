repeat task.wait() until game:IsLoaded()

-- ================================================
-- 1. TẠO NÚT BẬT/TẮT DẠNG BO DÀI HIỆN FPS (KIỂU ẢNH MẪU)
-- ================================================
local CoreGui = game:GetService("CoreGui")
local RunService = game:GetService("RunService")

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "VNCheatUI_Screen"
ScreenGui.Parent = CoreGui
ScreenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling

-- Khung chứa nút hình capsule bo dài
local ToggleBtn = Instance.new("TextButton")
ToggleBtn.Name = "ToggleBtn"
ToggleBtn.Parent = ScreenGui
ToggleBtn.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
ToggleBtn.BackgroundTransparency = 0.2
ToggleBtn.BorderSizePixel = 0
ToggleBtn.Position = UDim2.new(0.05, 0, 0.15, 0)
ToggleBtn.Size = UDim2.new(0, 105, 0, 36)
ToggleBtn.Draggable = true
ToggleBtn.Text = ""
ToggleBtn.AutoButtonColor = false

local ToggleCorner = Instance.new("UICorner")
ToggleCorner.CornerRadius = UDim.new(1, 0) -- Bo tròn 2 đầu dạng viên thuốc
ToggleCorner.Parent = ToggleBtn

local ToggleStroke = Instance.new("UIStroke")
ToggleStroke.Color = Color3.fromRGB(45, 45, 55)
ToggleStroke.Thickness = 1
ToggleStroke.Parent = ToggleBtn

-- Logo tròn bên trong nút
local LogoImg = Instance.new("ImageLabel")
LogoImg.Parent = ToggleBtn
LogoImg.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
LogoImg.Position = UDim2.new(0, 4, 0, 4)
LogoImg.Size = UDim2.new(0, 28, 0, 28)
LogoImg.Image = "rbxassetid://119806186864286"

local LogoCorner = Instance.new("UICorner")
LogoCorner.CornerRadius = UDim.new(1, 0)
LogoCorner.Parent = LogoImg

-- Chữ FPS màu xanh lá
local FpsLabel = Instance.new("TextLabel")
FpsLabel.Parent = ToggleBtn
FpsLabel.BackgroundTransparency = 1
FpsLabel.Position = UDim2.new(0, 36, 0, 0)
FpsLabel.Size = UDim2.new(1, -40, 1, 0)
FpsLabel.Font = Enum.Font.SourceSansBold
FpsLabel.Text = "60.0 fps"
FpsLabel.TextColor3 = Color3.fromRGB(50, 220, 90) -- Xanh lá chuẩn ảnh
FpsLabel.TextSize = 14
FpsLabel.TextXAlignment = Enum.TextXAlignment.Center

-- Tự động tính toán & cập nhật FPS thực tế
local frameCount = 0
local lastUpdate = tick()
RunService.RenderStepped:Connect(function()
	frameCount = frameCount + 1
	if tick() - lastUpdate >= 0.5 then
		local fps = frameCount / (tick() - lastUpdate)
		FpsLabel.Text = string.format("%.1f fps", fps)
		frameCount = 0
		lastUpdate = tick()
	end
end)


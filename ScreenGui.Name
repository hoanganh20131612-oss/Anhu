MainFrame.Size = UDim2.new(0, 520, 0, 320)
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Visible = true

-- Viền sắc cạnh màu xám tối
local MainStroke = Instance.new("UIStroke")
MainStroke.Color = Color3.fromRGB(50, 50, 60)
MainStroke.Thickness = 1
MainStroke.Parent = MainFrame

-- --- Topbar Chuẩn macOS (Cạnh nhọn) ---
local Topbar = Instance.new("Frame")
Topbar.Name = "Topbar"
Topbar.Parent = MainFrame
Topbar.BackgroundColor3 = Color3.fromRGB(26, 26, 30)
Topbar.BorderSizePixel = 0
Topbar.Size = UDim2.new(1, 0, 0, 32)

-- Nút macOS Red/Yellow/Green
local MacBtns = Instance.new("Frame")
MacBtns.Parent = Topbar
MacBtns.BackgroundTransparency = 1
MacBtns.Position = UDim2.new(0, 10, 0, 10)
MacBtns.Size = UDim2.new(0, 50, 0, 12)

local function createMacDot(color, pos)
	local dot = Instance.new("Frame")
	dot.Parent = MacBtns
	dot.BackgroundColor3 = color
	dot.BorderSizePixel = 0
	dot.Position = UDim2.new(0, pos, 0, 0)
	dot.Size = UDim2.new(0, 12, 0, 12)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(1, 0)
	c.Parent = dot
end
createMacDot(Color3.fromRGB(255, 95, 86), 0)
createMacDot(Color3.fromRGB(255, 189, 46), 16)
createMacDot(Color3.fromRGB(39, 201, 63), 32)

-- Tiêu đề Menu
local TitleLabel = Instance.new("TextLabel")
TitleLabel.Parent = Topbar
TitleLabel.BackgroundTransparency = 1
TitleLabel.Position = UDim2.new(0, 0, 0, 0)
TitleLabel.Size = UDim2.new(1, 0, 1, 0)
TitleLabel.Font = Enum.Font.SourceSansBold
TitleLabel.Text = "hoanganhvip | vip pro💎😍"
TitleLabel.TextColor3 = Color3.fromRGB(255, 215, 0)
TitleLabel.TextSize = 14

-- Sự kiện Bật/Tắt Menu khi bấm nút FPS
ToggleBtn.MouseButton1Click:Connect(function()
	MainFrame.Visible = not MainFrame.Visible
end)

-- ================================================
-- 3. KHUNG MENU TRÁI (SIDEBAR) & NỘI DUNG PHẢI
-- ================================================
local Sidebar = Instance.new("Frame")
Sidebar.Parent = MainFrame
Sidebar.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
Sidebar.BorderSizePixel = 0
Sidebar.Position = UDim2.new(0, 0, 0, 32)
Sidebar.Size = UDim2.new(0, 130, 1, -32)

local SidebarList = Instance.new("UIListLayout")
SidebarList.Parent = Sidebar
SidebarList.SortOrder = Enum.SortOrder.LayoutOrder

local ContentContainer = Instance.new("Frame")
ContentContainer.Parent = MainFrame
ContentContainer.BackgroundTransparency = 1
ContentContainer.Position = UDim2.new(0, 135, 0, 37)
ContentContainer.Size = UDim2.new(1, -140, 1, -42)

local tabs = {}

local function createTab(tabName, layoutOrder)
	local TabBtn = Instance.new("TextButton")
	TabBtn.Parent = Sidebar
	TabBtn.BackgroundTransparency = 1
	TabBtn.Size = UDim2.new(1, 0, 0, 38)
	TabBtn.Font = Enum.Font.SourceSansSemibold
	TabBtn.Text = "   " .. tabName
	TabBtn.TextColor3 = Color3.fromRGB(154, 154, 176)
	TabBtn.TextSize = 13
	TabBtn.TextXAlignment = Enum.TextXAlignment.Left
	TabBtn.LayoutOrder = layoutOrder

	local Indicator = Instance.new("Frame")
	Indicator.Parent = TabBtn
	Indicator.BackgroundColor3 = Color3.fromRGB(0, 136, 255)
	Indicator.BorderSizePixel = 0
	Indicator.Size = UDim2.new(0, 3, 1, 0)
	Indicator.Visible = false

	local TabPage = Instance.new("ScrollingFrame")
	TabPage.Parent = ContentContainer
	TabPage.BackgroundTransparency = 1
	TabPage.Size = UDim2.new(1, 0, 1, 0)
	TabPage.Visible = false
	TabPage.ScrollBarThickness = 3
	TabPage.CanvasSize = UDim2.new(0, 0, 0, 0)

	local PageList = Instance.new("UIListLayout")
	PageList.Parent = TabPage
	PageList.SortOrder = Enum.SortOrder.LayoutOrder
	PageList.Padding = UDim.new(0, 6)

	PageList:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		TabPage.CanvasSize = UDim2.new(0, 0, 0, PageList.AbsoluteContentSize.Y + 10)
	end)

	TabBtn.MouseButton1Click:Connect(function()
		for _, t in pairs(tabs) do
			t.Page.Visible = false
			t.Btn.TextColor3 = Color3.fromRGB(154, 154, 176)
			t.Indicator.Visible = false
		end
		TabPage.Visible = true
		TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		Indicator.Visible = true
	end)

	local tabData = {Btn = TabBtn, Page = TabPage, Indicator = Indicator}
	table.insert(tabs, tabData)

	if #tabs == 1 then
		TabPage.Visible = true
		TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		Indicator.Visible = true
	end

	return TabPage
end

-- Hàm Thêm Nút Bấm Thực Thi (Giao diện cạnh vuông nhọn)
local function addScriptButton(tabPage, title, description, callback)
	local ItemFrame = Instance.new("Frame")
	ItemFrame.Parent = tabPage
	ItemFrame.BackgroundColor3 = Color3.fromRGB(26, 26, 32)
	ItemFrame.BorderSizePixel = 0
	ItemFrame.Size = UDim2.new(1, -6, 0, 48)

	local TitleLbl = Instance.new("TextLabel")
	TitleLbl.Parent = ItemFrame
	TitleLbl.BackgroundTransparency = 1
	TitleLbl.Position = UDim2.new(0, 10, 0, 6)
	TitleLbl.Size = UDim2.new(0.7, 0, 0, 18)
	TitleLbl.Font = Enum.Font.SourceSansBold
	TitleLbl.Text = title
	TitleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
	TitleLbl.TextSize = 13
	TitleLbl.TextXAlignment = Enum.TextXAlignment.Left

	local DescLbl = Instance.new("TextLabel")
	DescLbl.Parent = ItemFrame
	DescLbl.BackgroundTransparency = 1
	DescLbl.Position = UDim2.new(0, 10, 0, 24)
	DescLbl.Size = UDim2.new(0.7, 0, 0, 16)
	DescLbl.Font = Enum.Font.SourceSans
	DescLbl.Text = description or ""
	DescLbl.TextColor3 = Color3.fromRGB(150, 150, 160)
	DescLbl.TextSize = 11
	DescLbl.TextXAlignment = Enum.TextXAlignment.Left

	local RunBtn = Instance.new("TextButton")
	RunBtn.Parent = ItemFrame
	RunBtn.BackgroundColor3 = Color3.fromRGB(0, 136, 255)
	RunBtn.BorderSizePixel = 0
	RunBtn.Position = UDim2.new(1, -70, 0, 10)
	RunBtn.Size = UDim2.new(0, 60, 0, 28)
	RunBtn.Font = Enum.Font.SourceSansBold
	RunBtn.Text = "Chạy"
	RunBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	RunBtn.TextSize = 12

	RunBtn.MouseButton1Click:Connect(function()
		pcall(callback)
	end)
end

